# Required — the app needs only these three.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=a-long-unique-password-12+chars

# Optional — contact form email notifications via Resend. Skipped when unset.
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=
# CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# Optional — canonical site URL. On Vercel the production URL is detected automatically.
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
